{
  "name": "codex-agent-mcp",
  "version": "0.1.0",
  "description": "Thin MCP adapter for OpenAI-hosted Codex agent sessions",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:integration": "RUN_OPENAI_INTEGRATION=1 vitest run tests/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "openai": "^5.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
